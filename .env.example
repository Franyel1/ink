# Copy to .env.local and fill in from your Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI API key for the AI layer: post analysis (ai_summary / ai_topics),
# personalized reflect questions, and the running notebook memory built
# from the user's answers. All via gpt-4.1-mini.
# Server-side only — never exposed to the browser. Get one at https://platform.openai.com
OPENAI_API_KEY=sk-...
